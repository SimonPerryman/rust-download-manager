{
  "version": 1,
  "projectType": "mixed",
  "conventions": ["CLAUDE.md", "AGENTS.md"],
  "defaultBranch": "main",
  "gate": {
    "format": "cargo fmt --all --check && pnpm --dir gui format:check",
    "lint": "cargo clippy --all-targets -- -D warnings && cargo clippy -p rdm-gui --all-targets -- -D warnings && pnpm --dir gui lint",
    "typecheck": "pnpm --dir gui build",
    "test": "cargo test && cargo test -p rdm-gui && pnpm --dir gui test"
  },
  "vcs": {
    "host": "github"
  },
  "review": {
    "panel": ["claude", "claude"],
    "maxIterations": 5
  },
  "plan": {
    "maxRounds": 3
  },
  "devStack": {
    "enabled": false,
    "provider": "none",
    "command": null,
    "healthUrl": null,
    "startTimeoutSec": 90
  },
  "e2e": {
    "enabled": true,
    "provider": "project-skill:rdm-e2e",
    "specDir": "gui/e2e/specs",
    "auth": "none"
  }
}
